# Konfigurasi Auto-Ban Bot

# Path menuju log Nginx (Bisa satu file, spasi untuk banyak file, atau wildcard: /var/log/nginx/*access*.log)
LOG_FILES="/var/log/nginx/access.log"

# Path menuju file pola per kategori serangan
PATTERN_SQLI="$(dirname "$0")/patterns_sqli.txt"
PATTERN_XSS="$(dirname "$0")/patterns_xss.txt"
PATTERN_TRAVERSAL="$(dirname "$0")/patterns_traversal.txt"
PATTERN_RCE="$(dirname "$0")/patterns_rce.txt"
PATTERN_SENSITIVE="$(dirname "$0")/patterns_sensitive.txt"

# Nama jail Fail2ban
JAIL_NAME="nginx-bot"

# Whitelist IP
WHITELIST_IPS="127.0.0.1 192.168.1. "

# Konfigurasi Threshold untuk File Sensitif
# Berapa kali maksimal mencoba dalam rentang waktu tertentu (dalam detik)
THRESHOLD_LIMIT=2
THRESHOLD_TIME=5

# Konfigurasi Notifikasi Telegram
# Kosongkan TOKEN jika tidak ingin mengirim ke Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Password Sudo / Root (Opsional)
# Kosongkan jika bot berjalan sebagai systemd service (User=root) atau user sudah passwordless sudo.
# Isi jika script dijalankan secara manual oleh user biasa yang memerlukan password sudo.
SUDO_PASSWORD=""

# Interval notifikasi Telegram untuk IP yang sudah diban tapi masih mencoba menyerang
# Nilai 2 artinya setiap 2 kali percobaan (ke-2, ke-4, ke-6, dst) akan dikirimkan alert
BANNED_REPEAT_INTERVAL=2

# Notifikasi HTTP Error (4xx & 5xx) - Notif Only (Tanpa Ban)
NOTIFY_HTTP_ERRORS="true"

# Zona Waktu untuk Notifikasi Telegram (Default: Asia/Jakarta / WIB)
TIMEZONE="Asia/Jakarta"
